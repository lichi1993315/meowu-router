FROM python:3.11-slim

WORKDIR /app

# 安装依赖
RUN pip install --no-cache-dir \
    prometheus-client \
    aiofiles \
    jieba

# 复制代码
COPY metrics_exporter.py .
COPY telemetry_platform.py /app/telemetry_platform.py
COPY telemetry_events.py /app/telemetry_events.py
COPY telemetry_analytics.py /app/telemetry_analytics.py
COPY version_utils.py .
COPY playtime_store.py .
COPY developer_admin.py .
COPY import_gameplay_telemetry.py .
COPY cleanup_output_retention.py .

# 创建数据目录
RUN mkdir -p /app/data /app/output

# 暴露端口
EXPOSE 9090

# 环境变量
ENV OUTPUT_DIR=/app/output
ENV DATA_DIR=/app/data
ENV METRICS_PORT=9090
ENV SCAN_INTERVAL=30

CMD ["python", "metrics_exporter.py"]

# Canonical analytics projection shared by incremental intake and snapshot importer.
COPY analytics_facts.py player_analytics.py /app/

# Journey projection and versioned node catalog.
COPY journey_analytics.py journey_catalog.json telemetry_time.py /app/
