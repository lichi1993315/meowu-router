    {
      "id": 1,
      "title": "画像证据覆盖",
      "type": "table",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "${DS_SQLITE}"
      },
      "description": "画像窗口固定为首次可操作入岛后 24 小时，规则 portrait-v1。主动时长为 15 秒操作窗口估算；观看、等待、前台无操作宽限、挂机、后台分别记录。无观察证据不补零。时间/平台/版本/渠道/批次筛选选择首次入岛 cohort，后续回访允许跨平台；显示实际样本数。第 2–7 天=[24h,168h)，D7=[168h,192h)。未成熟为空，相关性不代表因果。",
      "targets": [
        {
          "refId": "A",
          "queryType": "table",
          "queryText": "WITH settings AS (SELECT julianday('now') cutoff),\n    candidates AS (SELECT p.*,COALESCE(u.is_developer,0) is_developer FROM behavior_players p\n      LEFT JOIN user_sessions u USING(user_id)),\n    c AS (SELECT * FROM candidates WHERE ('__all__' IN (${client_platform:sqlstring}) OR client_platform IN (${client_platform:sqlstring})) AND ('__all__' IN (${release_version:sqlstring}) OR COALESCE(NULLIF(release_version,''),'__empty__') IN (${release_version:sqlstring})) AND ('${test_data}'='include' OR ('${test_data}'='auto' AND (client_platform='editor' OR (is_development_build=0 AND is_developer=0))) OR ('${test_data}'='exclude' AND is_development_build=0 AND is_developer=0 AND client_platform!='editor') OR ('${test_data}'='only' AND (is_development_build=1 OR is_developer=1 OR client_platform='editor'))) AND ('${playtest_id}'='all' OR ('${playtest_id}'='legacy' AND (user_id,session_id) NOT IN (SELECT user_id,session_id FROM analytics_session_playtests)) OR (user_id,session_id) IN (SELECT user_id,session_id FROM analytics_session_playtests WHERE playtest_id='${playtest_id}')) AND ('__all__' IN (${distribution_channel:sqlstring}) OR (user_id,session_id) IN (SELECT user_id,session_id FROM analytics_session_channels WHERE distribution_channel IN (${distribution_channel:sqlstring})) OR ('unknown' IN (${distribution_channel:sqlstring}) AND (user_id,session_id) NOT IN (SELECT user_id,session_id FROM analytics_session_channels))) AND julianday(first_at) >= julianday(${__from}/1000,'unixepoch') AND julianday(first_at) < julianday(${__to}/1000,'unixepoch')\n      AND (${user_id:sqlstring}='' OR user_id=${user_id:sqlstring})\n      AND (${behavior_cohort:sqlstring}='all' OR cohort_kind='new_observed')) SELECT quality 证据状态,cohort_kind 样本来源,COUNT(*) 玩家数,\n      SUM((SELECT cutoff FROM settings)<julianday(first_at)+1) 画像观察中,\n      SUM((SELECT cutoff FROM settings)<julianday(first_at)+8) D7待观察,\n      ROUND(SUM(unknown)/60,2) 未归类前台分钟 FROM c GROUP BY quality,cohort_kind",
          "rawQueryText": "WITH settings AS (SELECT julianday('now') cutoff),\n    candidates AS (SELECT p.*,COALESCE(u.is_developer,0) is_developer FROM behavior_players p\n      LEFT JOIN user_sessions u USING(user_id)),\n    c AS (SELECT * FROM candidates WHERE ('__all__' IN (${client_platform:sqlstring}) OR client_platform IN (${client_platform:sqlstring})) AND ('__all__' IN (${release_version:sqlstring}) OR COALESCE(NULLIF(release_version,''),'__empty__') IN (${release_version:sqlstring})) AND ('${test_data}'='include' OR ('${test_data}'='auto' AND (client_platform='editor' OR (is_development_build=0 AND is_developer=0))) OR ('${test_data}'='exclude' AND is_development_build=0 AND is_developer=0 AND client_platform!='editor') OR ('${test_data}'='only' AND (is_development_build=1 OR is_developer=1 OR client_platform='editor'))) AND ('${playtest_id}'='all' OR ('${playtest_id}'='legacy' AND (user_id,session_id) NOT IN (SELECT user_id,session_id FROM analytics_session_playtests)) OR (user_id,session_id) IN (SELECT user_id,session_id FROM analytics_session_playtests WHERE playtest_id='${playtest_id}')) AND ('__all__' IN (${distribution_channel:sqlstring}) OR (user_id,session_id) IN (SELECT user_id,session_id FROM analytics_session_channels WHERE distribution_channel IN (${distribution_channel:sqlstring})) OR ('unknown' IN (${distribution_channel:sqlstring}) AND (user_id,session_id) NOT IN (SELECT user_id,session_id FROM analytics_session_channels))) AND julianday(first_at) >= julianday(${__from}/1000,'unixepoch') AND julianday(first_at) < julianday(${__to}/1000,'unixepoch')\n      AND (${user_id:sqlstring}='' OR user_id=${user_id:sqlstring})\n      AND (${behavior_cohort:sqlstring}='all' OR cohort_kind='new_observed')) SELECT quality 证据状态,cohort_kind 样本来源,COUNT(*) 玩家数,\n      SUM((SELECT cutoff FROM settings)<julianday(first_at)+1) 画像观察中,\n      SUM((SELECT cutoff FROM settings)<julianday(first_at)+8) D7待观察,\n      ROUND(SUM(unknown)/60,2) 未归类前台分钟 FROM c GROUP BY quality,cohort_kind"
        }
      ],
