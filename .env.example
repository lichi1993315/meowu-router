# Shared Fernet key for encrypted LLM proxy and telemetry uploads.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PAW_FERNET_KEY=your_urlsafe_base64_32_byte_fernet_key_here

# LLM Provider Configuration
GEMINI_API_KEY=your_gemini_or_vertex_api_key_here
GEMINI_BASE_URL=https://aiplatform.googleapis.com/v1/projects/your-project/locations/global/publishers/google
GEMINI_SDK_URL=https://aiplatform.googleapis.com/v1/projects/your-project/locations/global/publishers/google
DEFAULT_LLM_PROVIDER=vertex_ai
DEFAULT_LLM_MODEL=gemini-3-flash-preview
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview
# Grafana Configuration
GRAFANA_TOKEN=your_grafana_service_account_token_here
