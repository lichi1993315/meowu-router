# Feishu Bot Configuration
FEISHU_BOT_API_KEY=your_feishu_app_id_here
FEISHU_BOT_API_SECRET=your_feishu_app_secret_here
FEISHU_CHAT_ID=your_feishu_chat_id_here
FEISHU_ERROR_LOG_ALERTS=true

# Shared Fernet key for encrypted LLM proxy and telemetry uploads.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PAW_FERNET_KEY=your_urlsafe_base64_32_byte_fernet_key_here

# Grafana Configuration
GRAFANA_TOKEN=your_grafana_service_account_token_here
