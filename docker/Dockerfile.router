FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir --index-url https://pypi.org/simple -r /app/requirements.txt

COPY app /app/app
COPY encrypted_saver.py /app/encrypted_saver.py
COPY playtime_store.py /app/playtime_store.py
COPY telemetry_platform.py /app/telemetry_platform.py
COPY telemetry_events.py /app/telemetry_events.py
COPY telemetry_analytics.py /app/telemetry_analytics.py
COPY version_utils.py /app/version_utils.py

ENV PORT=8000

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]

# Canonical analytics projection shared by incremental intake and snapshot importer.
COPY analytics_facts.py player_analytics.py /app/
